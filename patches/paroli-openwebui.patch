+Task<HttpResponsePtr> v1::openaiSpeech(const HttpRequestPtr req)
+{
+    if(req->method() == Options)
+        co_return co_await synthesise(req);
+
+    if(req->getContentType() != CT_APPLICATION_JSON)
+        co_return makeBadRequestResponse("Content-Type must be application/json");
+
+    nlohmann::json adaptedBody;
+    try {
+        auto body = nlohmann::json::parse(req->getBody());
+        if(!body.contains("input") || !body["input"].is_string())
+            throw std::runtime_error("Missing string 'input' field");
+
+        adaptedBody["text"] = body["input"];
+        adaptedBody["audio_format"] = "opus";
+
+        if(body.contains("response_format")) {
+            if(!body["response_format"].is_string())
+                throw std::runtime_error("response_format must be a string");
+            auto responseFormat = body["response_format"].get<std::string>();
+            if(responseFormat == "pcm")
+                adaptedBody["audio_format"] = "pcm";
+            else if(responseFormat != "opus" && responseFormat != "ogg")
+                throw std::runtime_error("response_format must be opus, ogg, or pcm");
+        }
+
+        for(const auto *key : {"speaker_id", "speaker", "length_scale",
+                               "noise_scale", "noise_w", "audio_format"}) {
+            if(body.contains(key))
+                adaptedBody[key] = body[key];
+        }
+
+        if(body.contains("speed") && !adaptedBody.contains("length_scale")) {
+            if(!body["speed"].is_number())
+                throw std::runtime_error("speed must be a number");
+            auto speed = body["speed"].get<float>();
+            if(speed <= 0)
+                throw std::runtime_error("speed must be greater than zero");
+            adaptedBody["length_scale"] = 1.0f / speed;
+        }
+
+        if(!adaptedBody.contains("speaker") &&
+           !adaptedBody.contains("speaker_id") &&
+           body.contains("voice") && body["voice"].is_string()) {
+            auto requestedVoice = body["voice"].get<std::string>();
+            const auto& speakerIdMap = voice.modelConfig.speakerIdMap;
+            if(speakerIdMap.has_value() && speakerIdMap->contains(requestedVoice)) {
+                adaptedBody["speaker"] = requestedVoice;
+            }
+            else if(speakerIdMap.has_value() && requestedVoice != "default" &&
+                    requestedVoice != "alloy") {
+                throw std::runtime_error("Unknown voice " + requestedVoice);
+            }
+        }
+    }
+    catch(const std::exception& e) {
+        co_return makeBadRequestResponse(e.what());
+    }
+
+    auto adaptedRequest = HttpRequest::newHttpRequest();
+    adaptedRequest->setMethod(Post);
+    adaptedRequest->setContentTypeCode(CT_APPLICATION_JSON);
+    adaptedRequest->setBody(adaptedBody.dump());
+    auto authorization = req->getHeader("Authorization");
+    if(!authorization.empty())
+        adaptedRequest->addHeader("Authorization", authorization);
+
+    co_return co_await synthesise(adaptedRequest);
+}
+
+Task<HttpResponsePtr> v1::openaiModels(const HttpRequestPtr req)
+{
+    nlohmann::json model = {
+        {"id", "paroli"},
+        {"name", "Paroli RKNN"},
+        {"object", "model"}
+    };
+    nlohmann::json body = {
+        {"object", "list"},
+        {"data", nlohmann::json::array({model})},
+        {"models", nlohmann::json::array({model})}
+    };
+    auto resp = HttpResponse::newHttpResponse();
+    resp->setStatusCode(k200OK);
+    resp->setContentTypeCode(CT_APPLICATION_JSON);
+    resp->setBody(body.dump());
+    co_return resp;
+}
+
+Task<HttpResponsePtr> v1::openaiVoices(const HttpRequestPtr req)
+{
+    auto voices = nlohmann::json::array();
+    const auto& speakerIdMap = voice.modelConfig.speakerIdMap;
+    if(speakerIdMap.has_value() && !speakerIdMap->empty()) {
+        for(const auto& [name, id] : *speakerIdMap)
+            voices.push_back({{"id", name}, {"name", name}, {"speaker_id", id}});
+    }
+    else {
+        voices.push_back({{"id", "default"}, {"name", "Default"}, {"speaker_id", 0}});
+    }
+
+    auto resp = HttpResponse::newHttpResponse();
+    resp->setStatusCode(k200OK);
+    resp->setContentTypeCode(CT_APPLICATION_JSON);
+    resp->setBody(nlohmann::json({{"voices", voices}}).dump());
+    co_return resp;
+}
